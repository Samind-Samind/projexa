// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลสำหรับโมดูล Screen Tracking (สโคปงานส่งหลักสูตร NoSQL)
//
// ⚠️ ยังไม่มีล็อกอินในระบบ (ตามขอบเขตใน SCOPE.md — 3 บทบาท SA/ผู้รับผิดชอบ/PM
// แต่ยังไม่มี auth) จึงเปิดอ่าน/เขียนแบบไม่ต้องยืนยันตัวตนไปก่อน ต้องเปลี่ยนเป็น
// กฎที่รัดกุมขึ้นเมื่อระบบมีการล็อกอินและแยกสิทธิ์ตามบทบาทแล้ว
//
// วิธีใช้: คัดลอกเนื้อหาไฟล์นี้ไปวางที่ Firebase Console →
// Firestore Database → กฎ (Rules) → Publish
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
